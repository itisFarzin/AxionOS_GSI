From be9fd9b9f51eca2c0d5d1fe301f104c2a89d2fd0 Mon Sep 17 00:00:00 2001
From: Farzin Kazemzadeh <itisFarzin@proton.me>
Date: Sat, 11 Jul 2026 10:38:02 +0000
Subject: [PATCH 1/3] Add AxionOS

Signed-off-by: Farzin Kazemzadeh <itisFarzin@proton.me>
---
 AndroidProducts.mk |  2 ++
 lineage_gsi.mk     | 41 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+)
 create mode 100644 AndroidProducts.mk
 create mode 100644 lineage_gsi.mk

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
new file mode 100644
index 0000000..f0d64c8
--- /dev/null
+++ b/AndroidProducts.mk
@@ -0,0 +1,2 @@
+PRODUCT_MAKEFILES := \
+	$(LOCAL_DIR)/lineage_gsi.mk
diff --git a/lineage_gsi.mk b/lineage_gsi.mk
new file mode 100644
index 0000000..9827193
--- /dev/null
+++ b/lineage_gsi.mk
@@ -0,0 +1,41 @@
+$(call inherit-product, device/phh/treble/base.mk)
+$(call inherit-product, vendor/lineage/config/common_full_phone.mk)
+
+PRODUCT_NAME := treble_arm64_bvN
+PRODUCT_DEVICE := tdgsi_arm64_ab
+PRODUCT_BRAND := td
+PRODUCT_SYSTEM_BRAND := td
+PRODUCT_MODEL := AxionOS
+
+# Overwrite the inherited "emulator" characteristics
+PRODUCT_CHARACTERISTICS := device
+
+# Disable adb secure
+WITH_ADB_INSECURE := true
+
+# GSIs don't have kernel
+TARGET_NO_KERNEL := true
+
+# Maintainer
+AXION_MAINTAINER := itisFarzin
+
+# MTK UDFPS
+$(call soong_config_set_bool,surfaceflinger,has_mtk_udfps,true)
+
+# Don't require all requested packages to exist
+TARGET_DISABLE_EPPE := true
+
+# Blur
+TARGET_ENABLE_BLUR := true
+
+# AxionFx
+TARGET_INCLUDE_AXFX := true
+
+# Enable face unlock
+TARGET_FACE_UNLOCK_SUPPORTED := true
+
+# Bootanimation
+TARGET_BOOT_ANIMATION_RES := 1080
+
+# Disable INSTALLED_KERNEL_TARGET warning
+PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false
-- 
2.43.0

